-- Vallkyrion: Blox Fruits GUI Script
-- Save this script in your GitHub repository

local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local CloseButton = Instance.new("TextButton")
local FeaturesFrame = Instance.new("ScrollingFrame")
local UIPadding = Instance.new("UIPadding")
local UIListLayout = Instance.new("UIListLayout")

-- ScreenGui Properties
ScreenGui.Name = "VallkyrionGUI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- MainFrame Properties
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0.3, 0, 0.2, 0)
MainFrame.Size = UDim2.new(0, 400, 0, 300)

-- Title Properties
Title.Name = "Title"
Title.Parent = MainFrame
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Title.BorderSizePixel = 0
Title.Size = UDim2.new(1, 0, 0, 50)
Title.Font = Enum.Font.SourceSansBold
Title.Text = "Vallkyrion: Blox Fruits"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 20

-- CloseButton Properties
CloseButton.Name = "CloseButton"
CloseButton.Parent = MainFrame
CloseButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
CloseButton.BorderSizePixel = 0
CloseButton.Position = UDim2.new(0.9, -10, 0, 10)
CloseButton.Size = UDim2.new(0, 30, 0, 30)
CloseButton.Font = Enum.Font.SourceSansBold
CloseButton.Text = "X"
CloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseButton.TextSize = 18

-- FeaturesFrame Properties
FeaturesFrame.Name = "FeaturesFrame"
FeaturesFrame.Parent = MainFrame
FeaturesFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
FeaturesFrame.BorderSizePixel = 0
FeaturesFrame.Position = UDim2.new(0, 0, 0, 50)
FeaturesFrame.Size = UDim2.new(1, 0, 1, -50)
FeaturesFrame.CanvasSize = UDim2.new(0, 0, 2, 0)
FeaturesFrame.ScrollBarThickness = 6

-- UIPadding for FeaturesFrame
UIPadding.Parent = FeaturesFrame
UIPadding.PaddingLeft = UDim.new(0, 5)
UIPadding.PaddingTop = UDim.new(0, 5)

-- UIListLayout for FeaturesFrame
UIListLayout.Parent = FeaturesFrame
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 5)

-- Utility Function to Create Buttons for Features
local function createFeatureButton(text, callback)
    local Button = Instance.new("TextButton")
    Button.Parent = FeaturesFrame
    Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Button.BorderSizePixel = 0
    Button.Size = UDim2.new(1, -10, 0, 40)
    Button.Font = Enum.Font.SourceSans
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 18

    -- Trigger the callback when button is clicked
    Button.MouseButton1Click:Connect(callback)
end

-- Define Feature Buttons
createFeatureButton("Auto Farm", function()
    print("Auto Farm activated")
    -- Add your Auto Farm script logic here
end)

createFeatureButton("Teleport to Island", function()
    print("Teleport activated")
    -- Add your Teleport script logic here
end)

createFeatureButton("ESP (Player)", function()
    print("ESP activated")
    -- Add your ESP script logic here
end)

createFeatureButton("Devil Fruit Sniper", function()
    print("Sniper activated")
    -- Add your Devil Fruit Sniper script logic here
end)

createFeatureButton("Stat Allocation", function()
    print("Stat Allocation activated")
    -- Add your Stat Allocation script logic here
end)

-- CloseButton Functionality
CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)
